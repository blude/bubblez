{
  "name": "university-social-network-frontend",
  "version": "1.0.0",
  "description": "PWA frontend for University Social Network",
  "main": "src/index.html",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "lint": "eslint src/ --ext .js,.html",
    "lint:fix": "eslint src/ --ext .js,.html --fix",
    "format": "prettier --write src/",
    "generate-pwa": "workbox injectManifest"
  },
  "keywords": [
    "pwa",
    "university",
    "social-network",
    "education",
    "mobile",
    "progressive-web-app"
  ],
  "author": "University Social Network Team",
  "license": "MIT",
  "dependencies": {
    "socket.io-client": "^4.7.2"
  },
  "devDependencies": {
    "vite": "^4.4.9",
    "vite-plugin-pwa": "^0.16.4",
    "workbox-window": "^7.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "@playwright/test": "^1.38.0",
    "eslint": "^8.48.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.3",
    "@types/jest": "^29.5.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/index.html"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": ["text", "lcov", "html"]
  }
}